{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main-webview workspace, preferences and acknowledged review handoff.",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-pr-status",
    "allow-pr-associations",
    "allow-pr-map-head",
    "allow-pr-choose",
    "allow-pr-open",
    "allow-pr-page",
    "allow-pr-refresh",
    "allow-pr-compare",
    "allow-pr-files-page",
    "allow-pr-resolve-anchor",
    "allow-pr-file",
    "allow-pr-release",
    "allow-pr-open-link",
    "allow-workspace-snapshot",
    "allow-preferred-languages",
    "allow-open-chosen-repository",
    "allow-select-context",
    "allow-rename-repository",
    "allow-remove-repository",
    "allow-refresh-entry-availability",
    "allow-observe-selected-context",
    "allow-review-file",
    "allow-history-page",
    "allow-list-contexts",
    "allow-select-worktree",
    "allow-commit-files",
    "allow-upstream-files",
    "allow-review-commit-file",
    "allow-list-repository-files",
    "allow-review-repository-file",
    "allow-record-renderer-diagnostic",
    "allow-diagnostic-health",
    "allow-review-surface-bootstrap",
    "allow-review-surface-snapshot",
    "allow-subscribe-review-surface",
    "allow-companion-state",
    "allow-set-companion-enabled",
    "allow-publish-companion-presentation",
    "allow-pending-review-handoff",
    "allow-claim-review-handoff",
    "allow-ack-review-handoff"
  ]
}
