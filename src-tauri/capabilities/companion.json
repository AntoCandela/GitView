{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "companion",
  "description": "Read-only admitted-context review for the local macOS companion webview.",
  "platforms": ["macOS"],
  "local": true,
  "webviews": ["companion"],
  "permissions": [
    "allow-review-surface-bootstrap",
    "allow-review-surface-snapshot",
    "allow-subscribe-review-surface",
    "allow-workspace-snapshot",
    "allow-select-context",
    "allow-observe-selected-context",
    "allow-review-file",
    "allow-record-renderer-diagnostic",
    "allow-begin-companion-review",
    "allow-dismiss-companion",
    "allow-request-review-handoff",
    "allow-quit-companion"
  ]
}
